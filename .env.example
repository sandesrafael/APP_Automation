# Application Configuration
# Copy this file to .env and modify as needed

# App Settings
APP_NAME=Automation API
VERSION=1.0.0
DEBUG=false

# Server Settings
HOST=0.0.0.0
PORT=8000
RELOAD=true

# CORS Settings (comma-separated for multiple origins)
CORS_ORIGINS=["*"]

# Database Defaults
DEFAULT_DB_TYPE=postgres

# Paths (optional - defaults to project root)
OUTPUT_BASE_PATH=
TEMP_PATH=
